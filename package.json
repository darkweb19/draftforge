{
  "name": "@draftforge-dev/draftforge",
  "version": "0.1.0",
  "description": "Model-orchestrated CLI for turning rough ideas into agent-ready project scaffolds.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darkweb19/draftforge.git"
  },
  "bugs": {
    "url": "https://github.com/darkweb19/draftforge/issues"
  },
  "homepage": "https://github.com/darkweb19/draftforge#readme",
  "type": "module",
  "bin": {
    "draftforge": "./dist/bin.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.16.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run lint && npm test && npm run session:check && npm run build",
    "dev": "tsx src/cli.ts",
    "lint": "oxlint src test scripts",
    "package:pack": "npm pack",
    "package:smoke": "node scripts/package-smoke.mjs",
    "prepack": "npm run build",
    "session:check": "node scripts/session-check.mjs",
    "session:render": "node scripts/session-render.mjs",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "oxlint": "1.75.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
